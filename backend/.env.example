# ---------------------------------------------------------------
# StudyMate backend configuration
# Copy this file to backend/.env (or run `npm run setup` from the project root)
# ---------------------------------------------------------------

# API server port (frontend dev server proxies /api here)
PORT=5000
NODE_ENV=development

# Frontend origin allowed by CORS (comma-separated for several)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB — local server:
MONGODB_URI=mongodb://127.0.0.1:27017/studymate
# ...or MongoDB Atlas (free M0 cluster):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studymate?retryWrites=true&w=majority

# JWT signing secret — use a long random string. `npm run setup` generates one.
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------
# Google Gemini API — FREE TIER ONLY (Google AI Studio)
# Get a key: https://aistudio.google.com/app/apikey  (no billing required)
# Leave GEMINI_API_KEY empty to run in fallback mode (built-in scheduler, assistant disabled).
# ---------------------------------------------------------------
GEMINI_API_KEY=your_api_key_here
# Must be a model listed as "Free of charge" at https://ai.google.dev/gemini-api/docs/pricing
# gemini-2.5-flash (default) or gemini-2.5-flash-lite (higher free quotas, lighter reasoning)
GEMINI_MODEL=gemini-2.5-flash
# Request timeout for Gemini calls (ms)
GEMINI_TIMEOUT_MS=45000
