{
  "name": "studymate-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@google/genai": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "jasmine": "^7.0.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  },
  "description": "StudyMate API — Express + MongoDB + Gemini (free tier) planning agent",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src src/server.js",
    "seed": "node scripts/seed.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:acceptance",
    "test:unit": "jasmine --config=spec/support/jasmine-unit.json",
    "test:integration": "jasmine --config=spec/support/jasmine-integration.json",
    "test:acceptance": "cucumber-js"
  }
}
